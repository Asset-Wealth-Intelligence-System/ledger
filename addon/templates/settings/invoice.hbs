<Layout::Section::Header @title={{t "literal.ledger.invoice-settings"}}>
    <Button
        @type="primary"
        @size="sm"
        @icon="save"
        @text={{t "literal.ledger.save-changes"}}
        @onClick={{perform this.saveSettings}}
        @disabled={{this.saveSettings.isRunning}}
        @isLoading={{or this.saveSettings.isRunning this.getSettings.isRunning}}
    />
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full">
    <div class="container mx-auto h-screen">
        <div class="max-w-3xl my-10 mx-auto space-y-6">

            {{! ── Numbering ──────────────────────────────────────────────────── }}
            <ContentPanel @title={{t "literal.ledger.invoice-numbering"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "literal.ledger.invoice-number-prefix"}} @helpText={{t "literal.ledger.this-prefix-is-prepended-to-every-new-invoice-nu-564ab"}}>
                    <Input @value={{this.invoice_prefix}} @type="text" class="w-full form-input" placeholder="INV" />
                </InputGroup>
            </ContentPanel>

            {{! ── Currency & Payment Terms ────────────────────────────────────── }}
            <ContentPanel @title={{t "literal.ledger.currency-payment-terms"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "literal.ledger.default-currency"}} @helpText={{t "literal.ledger.the-currency-applied-to-new-invoices-unless-over-6168b"}}>
                    <CurrencySelect
                        @currency={{this.effectiveCurrency}}
                        @currencyData={{this.selectedCurrency}}
                        @onCurrencyChange={{this.onSelectCurrency}}
                        @triggerClass="form-select form-input"
                        @placeholder={{concat "Default: " this.companyCurrency}}
                        @allowClear={{true}}
                    />
                    {{#unless this.default_currency}}
                        <p class="text-xs text-gray-400 mt-1">Using organisation default ({{this.companyCurrency}}). Select a currency above to override.</p>
                    {{/unless}}
                </InputGroup>

                <InputGroup @name={{t "literal.ledger.default-payment-terms"}} @helpText={{t "literal.ledger.number-of-days-after-the-invoice-date-that-payme-1b011"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.paymentTermsOptions}}
                            @selected={{find-by "value" this.payment_terms_days this.paymentTermsOptions}}
                            @onChange={{this.onSelectPaymentTerms}}
                            @placeholder={{t "literal.ledger.select-payment-terms"}}
                            @triggerClass="form-select form-input"
                            as |opt|
                        >
                            <div class="text-sm">{{opt.label}}</div>
                        </PowerSelect>
                    </div>
                </InputGroup>
            </ContentPanel>

            {{! ── Default Text ─────────────────────────────────────────────────── }}
            <ContentPanel @title={{t "literal.ledger.default-invoice-text"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "literal.ledger.default-notes"}} @helpText={{t "literal.ledger.these-notes-appear-at-the-bottom-of-every-new-in-050fd"}}>
                    <Textarea @value={{this.default_notes}} class="w-full form-input" rows="3" placeholder={{t "literal.ledger.e-g-thank-you-for-your-business"}} />
                </InputGroup>

                <InputGroup @name={{t "literal.ledger.default-terms-conditions"}} @helpText={{t "literal.ledger.standard-terms-pre-filled-on-every-new-invoice"}}>
                    <Textarea @value={{this.default_terms}} class="w-full form-input" rows="3" placeholder={{t "literal.ledger.e-g-payment-is-due-within-30-days-of-the-invoice-42361"}} />
                </InputGroup>
            </ContentPanel>

            {{! ── Default Template ─────────────────────────────────────────────── }}
            <ContentPanel @title={{t "literal.ledger.default-invoice-template"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup
                    @name={{t "literal.ledger.default-template"}}
                    @helpText={{t "literal.ledger.the-invoice-template-applied-to-all-new-invoices-621a0"}}
                >
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.availableTemplates}}
                            @selected={{this.selectedTemplate}}
                            @onChange={{this.onSelectDefaultTemplate}}
                            @placeholder={{t "literal.ledger.select-an-invoice-template"}}
                            @triggerClass="form-select form-input"
                            @allowClear={{true}}
                            as |template|
                        >
                            <div class="text-sm">{{template.name}}</div>
                        </PowerSelect>
                    </div>
                    {{#if this.selectedTemplate}}
                        <div class="mt-1 text-[11px] text-gray-500">
                            {{t "literal.ledger.selected-e8418"}}
                            <span class="font-medium">{{this.selectedTemplate.name}}</span>
                        </div>
                    {{/if}}
                    {{#unless this.availableTemplates.length}}
                        <div class="mt-1 text-[11px] text-amber-600">
                            {{t "literal.ledger.no-invoice-templates-found"}}
                            <LinkTo @route="billing.invoice-templates.index.new" class="underline">{{t "literal.ledger.create-a-template"}}</LinkTo>
                            {{t "literal.ledger.to-enable-custom-invoice-branding"}}
                        </div>
                    {{/unless}}
                </InputGroup>
            </ContentPanel>

            {{! ── Automation ───────────────────────────────────────────────────── }}
            <ContentPanel @title={{t "literal.ledger.automation"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "literal.ledger.auto-send-on-creation"}}>
                    <Toggle
                        @isToggled={{this.auto_send_on_creation}}
                        @label={{t "literal.ledger.automatically-email-the-invoice-to-the-customer-43201"}}
                        @onToggle={{fn (mut this.auto_send_on_creation)}}
                    />
                </InputGroup>
            </ContentPanel>
        </div>
        <Spacer @height="600px" />
    </div>
</Layout::Section::Body>